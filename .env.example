# Origen de la API, SIN el /api final. Es el único lugar donde se configura.
#   local       -> http://localhost:4000
#   producción  -> https://utracker-api.unify-tc.com
#
# Vite la resuelve al compilar: si la cambias en Vercel, hay que redesplegar.
# El origen del front debe estar en CORS_ORIGIN de la API, o el navegador
# bloqueará las llamadas.
VITE_API_URL=http://localhost:4000

# Solo para la app de Android (ver ANDROID.md). Sin ellas, la app usa
# producción: así un VITE_API_URL local no termina metido en el APK.
# VITE_NATIVE_API_URL=https://utracker-api.unify-tc.com
# VITE_PUBLIC_WEB_URL=https://utracker.unify-tc.com
